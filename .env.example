# Copy this file to .env (which is gitignored) and fill in a real value,
# or export the variable directly in your shell before starting the API.

# Required by src/api.py. The API refuses to start without it.
# Generate one locally, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
FRAUD_API_KEY=changeme

# Optional. Selects which trained model variant to serve. Defaults to "full".
# Other valid values: full_random, no_synthetic, no_ip_risk
MODEL_VARIANT=full

# Optional. Comma-separated list of origins allowed to call the API from a
# browser (sent back as Access-Control-Allow-Origin). Empty/unset means no
# cross-origin browser requests are allowed; server-to-server calls (curl,
# backend clients) are unaffected either way.
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Per-API-key request budget on /v1/score and /v1/score/batch.
# Defaults to 120.
RATE_LIMIT_PER_MIN=120

# Optional. Max request body size in bytes. Defaults to 1000000 (1MB).
MAX_CONTENT_LENGTH=1000000
