# Copy this file to .env (which is gitignored) and fill in a real value,
# or export the variable directly in your shell before starting the API.

# Required by src/api.py. The API refuses to start without it.
# Generate one locally, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
FRAUD_API_KEY=changeme

# Optional. Selects which trained model variant to serve. Defaults to "full".
# Other valid values: full_random, no_synthetic, no_ip_risk
MODEL_VARIANT=full
